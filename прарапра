#include <iostream>
#include <string>
using namespace std;

template <typename example>
void input(example& x, string s) {
	cout << s;
	cin >> x;
}

template <typename example>
void output(example x, string s) {
	cout << s << x << endl;
}

class Cilindr {
private:
    int id;
	float size_high, size_radius, ploshad_size, v_size;
public:
	Cilindr() {
		size_high = 0;
		size_radius = 0;
		ploshad_size = 0;
		v_size = 0;
	}
	void setId(int number) {
        id = number;
    }
    
    int getId() {
        return id;
    }
    
	void inputInfo() {
		input(size_high, "введите размер высоты: ");
		input(size_radius, "введите размер радиуса: ");
	}
    
	float getSizeHigh() {
		return size_high;
	}

	float getSizeRadius() {
		return size_radius;
	}

	float getPloshad() {
		ploshad_size = 3.14 * (size_radius * size_radius);
		return ploshad_size;
	}

	float getV_size() {
		v_size = getPloshad() * size_high;
		return v_size;
	}

	void printInfo() {
		output(size_high, "высота: ");
		output(size_radius, "радиус: ");
		output(getPloshad(), "площадь: ");
		output(getV_size(), "объём: ");
		cout << endl;
	}
};
void inputMassiv(Cilindr* arr, int count) {
	for (int i = 0; i < count; i++) {
	    arr[i].setId(i + 1);
		cout << "\n--- Ввод данных для цилиндра номер " << arr[i].getId() << " ---" << endl;
		arr[i].inputInfo();
	}
}

void countCilindr(Cilindr* arr, int count) {
	for (int i = 0; i < count; i++) {
		cout << "Цилиндр номер " << arr[i].getId() << endl;
		arr[i].printInfo();
	}
}

void maxPloshad(Cilindr* arr, int count) {
    float max = arr[0].getPloshad();
    for (int i = 1; i < count; i++) {
        if (arr[i].getPloshad() > max) {
            max = arr[i].getPloshad();
        }
    }
    int countMax = 0;
    for (int i = 0; i < count; i++) {
        if (arr[i].getPloshad() == max) {
            countMax++;
        }
    }

    if (countMax > 1) {
        cout << "Площади у нескольких фигур равны (максимальная площадь = "
             << max << "): ";
        for (int i = 0; i < count; i++) {
            if (arr[i].getPloshad() == max) {
                cout << arr[i].getId() << " ";
            }
        }
        cout << endl;
    } else {
        for (int i = 0; i < count; i++) {
            if (arr[i].getPloshad() == max) {
                cout << "Цилиндр с максимальной площадью (номер): " << arr[i].getId() << endl;
            }
        }
    }
}

void maxVolume(Cilindr* arr, int count) {
    float max = arr[0].getV_size();
    for (int i = 1; i < count; i++) {
        if (arr[i].getV_size() > max) {
            max = arr[i].getV_size();
        }
    }

    int countMax = 0;
    for (int i = 0; i < count; i++) {
        if (arr[i].getV_size() == max) {
            countMax++;
        }
    }

    if (countMax > 1) {
        cout << "Объёмы у нескольких фигур равны (максимальный объём = "
             << max << "): ";
        for (int i = 0; i < count; i++) {
            if (arr[i].getV_size() == max) {
                cout << arr[i].getId() << " ";
            }
        }
        cout << endl;
    } else {
        for (int i = 0; i < count; i++) {
            if (arr[i].getV_size() == max) {
                cout << "Цилиндр с максимальным объёмом (номер): " << arr[i].getId() << endl;
            }
        }
    }
}
Cilindr* newMassiv(int count) {
	return new Cilindr[count];
}

void deleteMassiv(Cilindr*& arr) {
	delete[] arr;
	arr = nullptr;
}

int main() {
	setlocale(LC_ALL, "Russian");
	int count;
	input(count, "введите количество цилиндров: ");
	if (count <= 0) {
		cout << "Недопустимое число" << endl;
		return 1;
	}
	Cilindr* arr = newMassiv(count);
	inputMassiv(arr, count);
	cout << "\n=== Вся информация о цилиндрах ===" << endl;
	countCilindr(arr, count);
	cout << "=== Результаты ===" << endl;
	maxPloshad(arr, count);
	maxVolume(arr, count);
	deleteMassiv(arr);
	return 0;
}
