#include <iostream>
#include <ctime>
#include <string>
using namespace std;

struct Student {
	string Fam;
	string Name;
	string Otch;
	string Faculty;
	int Course;
	string Group;
	double Average;
};

const string families[] = { "Иванов", "Петров", "Сидоров", "Кузнецов", "Смирнов" };
const string names[] = { "Иван", "Петр", "Алексей", "Дмитрий", "Сергей" };
const string otches[] = { "Иванович", "Петрович", "Алексеевич", "Дмитриевич" };
const string faculties[] = { "ФОиПО", "ФФК", "ФИЯ", "ЭЭ" };
const string groups[] = { "ДИ-16", "НК-15", "ЭЭ-21", "ЭБ-32", "ММ-41" };

template<typename T>
T input(const string& message) {
	T value;
	cout << message;
	cin >> value;
	return value;
}

void inputCount(int &n) {
	n = input<int>("Введите количество студентов: ");
}

Student* allocateMemory(int n) {
	Student* arr = new Student[n];
	return arr;
}

void freeMemory(Student* &arr) {
	if (arr != nullptr) {
		delete[] arr;
		arr = nullptr;
	}
}

void fillStudent(Student &s) {
	s.Fam = families[rand() % 5];
	s.Name = names[rand() % 5];
	s.Otch = otches[rand() % 4];
	s.Faculty = faculties[rand() % 4];
	s.Course = rand() % 4 + 1;
	s.Group = groups[rand() % 5];
	s.Average = (rand() % 31 + 20) / 10.0;
}

void fillAllStudents(Student* arr, int n) {
	for (int i = 0; i < n; i++) {
		fillStudent(arr[i]);
	}
}
void printStudent(const Student& s){
		cout << s.Fam << " " << s.Name << " " << s.Otch
			<< ", факультет: " << s.Faculty
			<< ", курс: " << s.Course
			<< ", группа: " << s.Group
			<< ", средний балл: " << s.Average << endl;
}
void printStudents(Student* arr, int n) {
	cout << "\n--- Список всех студентов ---\n";
	for (int i = 0; i < n; i++) {
		printStudent(arr[i]);
	}
}
void printStudentsInRange(Student* arr, int n) {
	cout << "\n=== Студенты со средним баллом от 3 до 4 ===\n";
	bool found = false;
	for (int i = 0; i < n; i++) {
		if (arr[i].Average >= 3.0 && arr[i].Average <= 4.0) {
			printStudent(arr[i]);
			found = true;
		}
	}
	if (!found) {
		cout << "Студентов с баллом от 3 до 4 не найдено." << endl;
	}
}

int main() {
	setlocale(LC_ALL, "Russian");
	srand(time(0));

	Student* students = nullptr;
	int n = 0;

	inputCount(n);
	if (n <= 0) {
		cout << "Ошибка: количество студентов должно быть больше 0" << endl;
		return 1;
	}

	students = allocateMemory(n);
	fillAllStudents(students, n);
	printStudents(students, n);
	printStudentsInRange(students, n);

	freeMemory(students);
	return 0;
}
